{
  "name": "dsh-weknora-ops",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin: the WRITE path for WeKnora \u2014 document ingest, gated deletes, tag trees \u2014 under a three-layer safety model. Complements the official read-only plugin.",
  "type": "module",
  "private": false,
  "bin": {
    "weknora-ops": "bin/weknora-ops.js"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "vicfei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicfei/dsh-weknora-ops.git"
  },
  "homepage": "https://github.com/vicfei/dsh-weknora-ops#readme",
  "bugs": {
    "url": "https://github.com/vicfei/dsh-weknora-ops/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "weknora",
    "agent",
    "plugin",
    "knowledge-base",
    "cli",
    "rag"
  ],
  "files": [
    "bin",
    "src",
    "skills",
    "cordis.patch.yml",
    "examples",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}